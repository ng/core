# shellcheck shell=bash
# Keep the systemd journal in RAM (/run/log/journal). Eight's firmware sets
# Storage=persistent and links /var/log/journal to /persistent/journal, so
# frank's steady log stream otherwise lands on the eMMC around the clock. A
# drop-in overrides journald.conf; logs from earlier boots are the cost.
# Shared by install and sp-update so existing pods pick it up on update.
install_journald_config() {
  local file="/etc/systemd/journald.conf.d/sleepypod.conf" tmp backup=""
  mkdir -p /etc/systemd/journald.conf.d
  tmp=$(mktemp)
  cat > "$tmp" <<'JOURNALD'
[Journal]
Storage=volatile
RuntimeMaxUse=48M
RuntimeKeepFree=100M
MaxFileSec=1week
JOURNALD
  if cmp -s "$tmp" "$file"; then
    rm -f "$tmp"
    return 0
  fi
  if [ -f "$file" ]; then
    backup=$(mktemp)
    cp -fp "$file" "$backup"
  fi
  install -m 0644 "$tmp" "$file"
  rm -f "$tmp"
  # journald keeps service stdout streams in its fd store across a restart.
  # If it won't restart, put the previous config back and bring journald up
  # on it, so the next install or update retries. Non-fatal either way.
  if ! systemctl restart systemd-journald 2>/dev/null; then
    if [ -n "$backup" ]; then
      install -m 0644 "$backup" "$file"
    else
      rm -f "$file"
    fi
    systemctl restart systemd-journald 2>/dev/null || true
    if systemctl is-active --quiet systemd-journald; then
      echo "Warning: systemd-journald rejected the RAM-only journal config — kept the previous one, will retry on next update" >&2
    else
      echo "Warning: systemd-journald is not running after restoring its previous config — check 'systemctl status systemd-journald'" >&2
    fi
  fi
  rm -f "$backup"
}
